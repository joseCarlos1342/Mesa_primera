# Configuración del actualizador `mesa-deploy` — copiar a /etc/mesa/deploy.env
# y restringir permisos: chmod 600 /etc/mesa/deploy.env

# Owner del repositorio en GitHub (parte de ghcr.io/<owner>/mesa-game-server).
GHCR_OWNER=tu-usuario-github

# Usuario para `docker login ghcr.io`. Puede ser el mismo owner o un service
# account dedicado al VPS.
GHCR_USERNAME=tu-usuario-github

# Personal Access Token (classic) con SOLO el scope `read:packages`.
# Generar en: https://github.com/settings/tokens
# Rotar cada 90 días. Nunca compartir; nunca subir a git.
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tag de la imagen a desplegar. Por defecto seguimos `main` (HEAD del workflow).
# Para fijar a un commit específico: IMAGE_TAG=sha-<full-commit-sha>
IMAGE_TAG=main

# Nombre del contenedor en docker.
CONTAINER_NAME=mesa-backend

# Archivo .env que el contenedor consume (REDIS_URL, SUPABASE_*, TWILIO_*, etc.).
ENV_FILE=/root/.env.production

# Directorio del host donde viven los replays persistentes.
REPLAYS_VOLUME=/root/replays

# Endpoint de health del game-server (host network → 127.0.0.1).
HEALTH_URL=http://127.0.0.1:2567/health

# Directorio donde se acumulan logs de cada ejecución del script.
FORCE_LOG_DIR=/var/log/mesa-deploy
